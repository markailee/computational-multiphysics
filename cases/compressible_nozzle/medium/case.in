mesh = ../mesh/nozzle_medium.msh
output = results/nozzle_medium.plt
flow_model = compressible
material_model = ideal_gas
time_scheme = steady

gas_constant = 287.0
viscosity = 0.0
thermal_conductivity = 0.0
specific_heat = 1005.0
initial_velocity = 100 0
initial_pressure = 100000
initial_temperature = 300
viscous_dissipation = false

gradient = least_squares
convection_blending = 0.0
energy_convection_blending = 0.0
velocity_relaxation = 0.3
pressure_relaxation = 0.02
energy_relaxation = 0.3
maximum_iterations = 8000
tolerance = 1.0e-5
energy_tolerance = 1.0e-5
density_tolerance = 1.0e-7
continuity_tolerance = 1.0e-7
linear_tolerance = 1.0e-9
linear_absolute_tolerance = 1.0e-12
maximum_linear_iterations = 1000
log_interval = 50

[boundary.inlet]
velocity = fixedValue 100 0
pressure = zeroGradient
temperature = fixedValue 300
[boundary.outlet]
velocity = zeroGradient
pressure = fixedValue 72039.24919441772
temperature = zeroGradient
[boundary.walls]
velocity = slip
pressure = zeroGradient
temperature = adiabatic
