physics = acoustic
mesh = mesh/fine_mixed.msh
output = results/convected_fine.plt

density = 1.0
sound_speed = 1.0
mean_velocity = 0.3 0
time_scheme = central_difference
dt = 0.00125
end_time = 0.7692307692307693
output_interval = 100000
log_interval = 200

initial_condition = plane_wave
initial_amplitude = 1.0
wave_direction = 1 0
wave_number = 6.283185307179586
wave_phase = 0.0
probe_position = 1.5 0.25

[boundary.left]
pressure = planeWave
[boundary.right]
pressure = planeWave
[boundary.bottom]
pressure = rigid
[boundary.top]
pressure = rigid
