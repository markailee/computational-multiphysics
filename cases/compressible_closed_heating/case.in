mesh = ../compressible_conduction/mesh/conduction.msh
output = results/closed_heating.plt
flow_model = compressible
material_model = ideal_gas
time_scheme = euler
dt = 0.01
end_time = 0.1
output_interval = 10

gas_constant = 287.0
viscosity = 1.8e-5
thermal_conductivity = 0.025
specific_heat = 1005.0
initial_velocity = 0 0
initial_pressure = 101325
initial_temperature = 300
heat_source = 1000.0
viscous_dissipation = false

gradient = least_squares
velocity_relaxation = 0.7
pressure_relaxation = 0.3
energy_relaxation = 0.8
maximum_iterations = 200
tolerance = 1.0e-9
energy_tolerance = 1.0e-10
density_tolerance = 1.0e-11
continuity_tolerance = 1.0e-12
linear_tolerance = 1.0e-11
linear_absolute_tolerance = 1.0e-14
log_interval = 50

[boundary.left]
velocity = noSlip
pressure = zeroGradient
temperature = adiabatic
[boundary.right]
velocity = noSlip
pressure = zeroGradient
temperature = adiabatic
[boundary.walls]
velocity = noSlip
pressure = zeroGradient
temperature = adiabatic
