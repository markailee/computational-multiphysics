physics = neutron
neutron_model = diffusion
problem_type = transient
mesh = mesh/twigl_2cm.msh
output = results/twigl_ramp.plt

energy_groups = 2
materials = seed1 seed2 blanket
default_material = blanket
regions = corner_seed side_seed_x side_seed_y

neutron_velocity = 1.0e7 2.0e5
delayed_beta = 0.0075
delayed_lambda = 0.08
delayed_chi = 1.0 0.0

critical_initial_state = true
time_scheme = crank_nicolson
time_step = 0.005
end_time = 0.5
transient_output_interval = 2
log_interval = 20

transient_events = ramp_insert

initial_flux = 1.0
maximum_iterations = 200
tolerance = 1.0e-11
eigen_tolerance = 1.0e-12
balance_tolerance = 1.0e-9
linear_solver = preonly
preconditioner = lu

[material.seed1]
diffusion_coefficient = 1.4 0.4
sigma_absorption = 0.010 0.150
scattering = 0.0 0.0 0.010 0.0
nu_sigma_fission = 0.007 0.200
kappa_sigma_fission = 0.007 0.200
chi = 1.0 0.0

[material.seed2]
diffusion_coefficient = 1.4 0.4
sigma_absorption = 0.010 0.150
scattering = 0.0 0.0 0.010 0.0
nu_sigma_fission = 0.007 0.200
kappa_sigma_fission = 0.007 0.200
chi = 1.0 0.0

[material.blanket]
diffusion_coefficient = 1.3 0.5
sigma_absorption = 0.008 0.050
scattering = 0.0 0.0 0.010 0.0
nu_sigma_fission = 0.003 0.060
kappa_sigma_fission = 0.003 0.060
chi = 1.0 0.0

[region.corner_seed]
material = seed1
bounds = 24.0 56.0 24.0 56.0

[region.side_seed_x]
material = seed2
bounds = 0.0 24.0 24.0 56.0

[region.side_seed_y]
material = seed2
bounds = 24.0 56.0 0.0 24.0

[event.ramp_insert]
region = corner_seed
type = ramp
start_time = 0.0
end_time = 0.2
delta_absorption = 0.0 -0.0035

[boundary.left]
neutron = zero_current
[boundary.bottom]
neutron = zero_current
[boundary.right]
neutron = fixed_flux 0.0
[boundary.top]
neutron = fixed_flux 0.0
