mesh = ../mesh/bump_10.msh
output = results/bump_transonic_final.plt
flow_model = compressible
material_model = ideal_gas
time_scheme = steady

gas_constant = 287.0
viscosity = 0.0
thermal_conductivity = 0.0
specific_heat = 1005.0
initial_velocity = 230.339754553282 0
initial_pressure = 103551.51193872
initial_temperature = 289.814640852331
viscous_dissipation = false

gradient = least_squares
gradient_limiter = venkatakrishnan
velocity_relaxation = 0.5
pressure_relaxation = 0.3
energy_relaxation = 0.5
maximum_iterations = 5000
tolerance = 1.0e-4
energy_tolerance = 1.0e-5
density_tolerance = 1.0e-7
continuity_tolerance = 1.0e-7
linear_tolerance = 1.0e-9
linear_absolute_tolerance = 1.0e-12
maximum_linear_iterations = 1000
log_interval = 100

[boundary.inlet]
velocity = direction 1 0
pressure = totalPressure 140513.23
temperature = totalTemperature 316.224
[boundary.outlet]
velocity = zeroGradient
pressure = fixedValue 101300.0
temperature = zeroGradient
[boundary.upper_wall]
velocity = slip
pressure = zeroGradient
temperature = adiabatic
[boundary.lower_wall]
velocity = slip
pressure = zeroGradient
temperature = adiabatic
