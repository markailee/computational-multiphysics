mesh = ../mesh/bump_04.msh
output = results/bump_supersonic_final.plt
flow_model = compressible
material_model = ideal_gas
time_scheme = steady

gas_constant = 287.0
viscosity = 2.0
thermal_conductivity = 2.0
specific_heat = 1005.0
initial_velocity = 486.06419329138 0
initial_pressure = 101325.0
initial_temperature = 300.0
viscous_dissipation = true

gradient = least_squares
gradient_limiter = barth_jespersen
velocity_relaxation = 0.05
pressure_relaxation = 0.001
energy_relaxation = 0.05
maximum_iterations = 120000
tolerance = 5.0e-3
energy_tolerance = 1.0e-4
density_tolerance = 1.0e-6
continuity_tolerance = 1.0e-5
linear_tolerance = 1.0e-9
linear_absolute_tolerance = 1.0e-12
maximum_linear_iterations = 1000
log_interval = 100

[boundary.inlet]
velocity = fixedValue 486.06419329138 0
pressure = fixedValue 101325.0
temperature = fixedValue 300.0
[boundary.outlet]
velocity = zeroGradient
pressure = zeroGradient
temperature = zeroGradient
[boundary.upper_wall]
velocity = slip
pressure = zeroGradient
temperature = adiabatic
[boundary.lower_wall]
velocity = slip
pressure = zeroGradient
temperature = adiabatic
