physics = acoustic
mesh = mesh/acoustic.msh
output = results/acoustic.plt

density = 1.0
sound_speed = 5.0
mean_velocity = 1 0
time_scheme = central_difference
dt = 0.02
output_interval = 100
log_interval = 200
linear_tolerance = 1.0e-10
linear_absolute_tolerance = 1.0e-13
maximum_linear_iterations = 1000
acoustic_ksp = bcgs
acoustic_pc = ilu

initial_condition = zero
source_type = flow_dipole
source_file = source/flow_dipole.csv
source_position = 0 0
source_width = 0.5
source_scale = 1.0
source_ramp_time = 1.0
probe_positions = 0 10 7.071067811865 7.071067811865 10 0 7.071067811865 -7.071067811865 0 -10 -7.071067811865 -7.071067811865 -10 0 -7.071067811865 7.071067811865 0 5 5 0

[boundary.left]
pressure = absorbing
[boundary.right]
pressure = absorbing
[boundary.bottom]
pressure = absorbing
[boundary.top]
pressure = absorbing
