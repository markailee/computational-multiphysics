physics = acoustic
mesh = mesh/fine.msh
output = results/rigid.plt

density = 1.0
sound_speed = 1.0
mean_velocity = 0 0
time_scheme = central_difference
dt = 0.0025
end_time = 4.0
output_interval = 400
log_interval = 200

initial_condition = gaussian_pulse
initial_amplitude = 1.0
gaussian_center = 1.0 0.5
gaussian_width = 0.12
wave_direction = 1 0
probe_position = 3.5 0.5

[boundary.left]
pressure = absorbing
[boundary.right]
pressure = rigid
[boundary.bottom]
pressure = rigid
[boundary.top]
pressure = rigid
