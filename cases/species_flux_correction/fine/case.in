mesh = ../mesh/correction_fine.msh
output = results/correction_fine.plt
material_model = ideal_gas
species_model = transport
flow_coupling = passive
species = A B
diffusion_model = constant
temperature = 300
thermo_pressure = 89083.52805164186
density = 1.0
viscosity = 1.8e-5
initial_velocity = 0 0
initial_mass_fractions = 0.5 0.5
time_scheme = steady
gradient = least_squares
species_relaxation = 1.0
maximum_iterations = 2000
tolerance = 1.0e-11
continuity_tolerance = 1.0e-12
species_tolerance = 1.0e-12
species_composition_tolerance = 1.0e-11
linear_tolerance = 1.0e-12
linear_absolute_tolerance = 1.0e-14
log_interval = 25

[species.A]
molar_mass = 0.028
viscosity = 1.8e-5
thermal_conductivity = 0.025
specific_heat = 1000
diffusivity = 2.0e-5
[species.B]
molar_mass = 0.028
viscosity = 1.8e-5
thermal_conductivity = 0.025
specific_heat = 1000
diffusivity = 5.0e-6

[boundary.surface]
velocity = noSlip
pressure = zeroGradient
mass_fractions = fixedValue 0.8 0.2
[boundary.outlet]
velocity = noSlip
pressure = zeroGradient
mass_fractions = fixedValue 0.1 0.9
[boundary.sides]
velocity = noSlip
pressure = zeroGradient
mass_fractions = zeroGradient
